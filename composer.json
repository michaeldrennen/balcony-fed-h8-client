{
    "name": "michaeldrennen/balcony-fed-h8-client",
    "description": "SDK client for the Federal Reserve H.8 commercial bank balance sheet release in The Balcony macro flow system",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Drennen",
            "homepage": "https://github.com/michaeldrennen"
        }
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.8"
    },
    "suggest": {
        "illuminate/database": "Required to use bundled Eloquent models (^10.0|^11.0|^12.0)"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "orchestra/testbench": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "MichaelDrennen\\Balcony\\FedH8Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MichaelDrennen\\Balcony\\FedH8Client\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
